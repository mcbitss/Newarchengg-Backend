# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/newarch

# Server Port
PORT=4000

# Admin Credentials (used to bootstrap the admin account via `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# Secret used to sign/verify admin login JWTs
JWT_SECRET=replace_with_a_long_random_string
