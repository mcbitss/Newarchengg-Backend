{
  "name": "newarch_api",
  "version": "1.0.0",
  "description": "newarch api",
  "main": "app.js",
  "scripts": {
    "start": "nodemon",
    "build": "babel --presets=@babel/preset-env src -d build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "migrate-mongo",
    "format": "./node_modules/.bin/prettier --check ./src",
    "format:fix": "./node_modules/.bin/prettier --write ./src",
    "lint": "./node_modules/.bin/eslint ./src --ext .js",
    "lint:fix": "./node_modules/.bin/eslint ./src --ext .js --fix",
    "update": "babel-node --presets=@babel/preset-env ./updateData.js",
    "seed:admin": "babel-node --presets=@babel/preset-env ./scripts/seedAdmin.js",
    "seed:projects": "babel-node --presets=@babel/preset-env ./scripts/seedProjects.js",
    "migrate:media": "babel-node --presets=@babel/preset-env ./scripts/migrate-media-to-s3.js"
  },
  "author": "Mcbitss",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "axios": "^1.3.4",
    "bluebird": "^3.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv-safe": "^8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.7.1",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.34",
    "mongoose": "^5.12.9",
    "mongoose-float": "^1.0.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.3",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.5.0",
    "nodemailer-sendgrid": "^1.0.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "regenerator-runtime": "^0.13.9",
    "uuid": "^8.3.2",
    "xlsx": "^0.17.3",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.0",
    "@babel/core": "^7.16.0",
    "@babel/node": "^7.16.0",
    "@babel/preset-env": "^7.16.4",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^4.3.8",
    "lint-staged": "^10.2.13",
    "nodemon": "^2.0.6",
    "organize-imports-cli": "^0.8.0",
    "prettier": "^2.5.1"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "*.js",
    "exec": "babel-node --presets=@babel/preset-env ./src/app.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "organize-imports-cli",
      "prettier --write",
      "eslint --fix"
    ]
  }
}
